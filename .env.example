PORT=4000
JWT_SECRET=replace_with_your_own_random_jwt_secret_key
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_NAME=Exam Administrator
NODE_ENV=production
DATA_DIR=./data
UPLOAD_DIR=./server/uploads

# (Optional) Firebase Cloud Integration for Vercel Serverless
# Generate service account JSON in Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

